Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^_private(?:/|$) - [F,L,NC]
RewriteRule ^index\.php$ - [L]
RewriteRule ^(?:assets/(?:editor\.js|document-ocr\.js|site\.css|resume\.css))$ - [L]
RewriteRule ^assets/ocr/(?:tesseract\.min\.js|worker\.min\.js|tesseract-core-lstm\.wasm\.js|tesseract-core-lstm\.wasm|ron\.traineddata\.gz)$ - [L]
RewriteRule ^ index.php [L]
<IfModule mod_headers.c>
  <Files "worker.min.js">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'"
  </Files>
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
</IfModule>
